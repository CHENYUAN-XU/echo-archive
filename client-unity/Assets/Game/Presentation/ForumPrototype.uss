:root {
    --ink: #edf1e8;
    --muted: #c2cfc3;
    --faint: #a5b5aa;
    --line: #59716a;
    --panel: #22312e;
    --panel-soft: #293c37;
    --paper: #30443e;
    --accent: #d3dd9d;
    --warning: #ecc393;
}

.forum-shell {
    flex-grow: 1;
    min-height: 0;
    background-color: #172522;
    color: var(--ink);
    padding: 18px 24px 14px;
    font-size: 16px;
    letter-spacing: 0.2px;
}

.grain-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(160, 182, 153, 0.025); }
.topbar { height: 84px; flex-shrink: 0; border-bottom-width: 1px; border-bottom-color: var(--line); padding-bottom: 4px; }
.topbar-brand-row, .topbar-nav-row { flex-direction: row; align-items: center; min-height: 37px; }
.topbar-brand-row { border-bottom-width: 1px; border-bottom-color: #34483f; }
.topbar-nav-row { padding-top: 4px; }
.wordmark { background-color: transparent; color: #d7dc9e; border-width: 0; font-size: 21px; -unity-font-style: bold; letter-spacing: 2.5px; padding-left: 0; }
.wordmark:hover { color: #fcf5b7; background-color: transparent; }
.subtitle { color: var(--muted); margin-left: 12px; font-size: 14px; }
.topbar-spacer { flex-grow: 1; }
.offline-status { color: var(--warning); font-size: 13px; margin-right: 12px; }
.placeholder-button { color: #737d77; background-color: #17211f; border-color: #2b3a36; border-width: 1px; border-radius: 0; font-size: 11px; margin-left: 8px; }
.placeholder-button:disabled { opacity: 1; }
.body-frame { flex-grow: 1; min-height: 0; flex-direction: row; padding-top: 10px; padding-bottom: 8px; }
.left-rail { width: 190px; flex-shrink: 0; padding-right: 18px; border-right-width: 1px; border-right-color: var(--line); }
.main-column { flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; padding-left: 20px; padding-right: 20px; }
.right-rail { width: 248px; flex-shrink: 0; padding-left: 18px; border-left-width: 1px; border-left-color: var(--line); }
.section-label, .sidebar-title { color: #dde2aa; font-size: 13px; letter-spacing: 1px; -unity-font-style: bold; margin-bottom: 10px; }
.board-navigation { margin-bottom: 18px; }
.board-link { background-color: #253631; border-width: 1px; border-color: #455b53; border-left-width: 3px; border-left-color: transparent; border-radius: 0; color: #e1e9dc; padding: 10px 12px; margin-bottom: 5px; font-size: 14px; -unity-text-align: middle-left; }
.board-link:hover { background-color: #182522; border-left-color: var(--accent); color: #f1eddd; }
.rail-rule { height: 1px; background-color: #2a3935; margin-bottom: 18px; }
.rail-note { color: var(--faint); font-size: 14px; white-space: normal; }
.home-heading { flex-direction: row; justify-content: space-between; align-items: flex-end; margin-bottom: 14px; }
.page-title { color: #e3e4d6; font-size: 25px; -unity-font-style: bold; letter-spacing: 1px; }
.page-description, .time-zone { color: var(--muted); font-size: 14px; margin-top: 4px; }
.time-zone { color: #c2cfc3; }
.home-view, .compose-view, .detail-view, .community-view { flex-grow: 1; min-height: 0; }
.thread-list { flex-grow: 1; }
.thread-card { display: flex; background-color: #263833; border-width: 1px; border-color: #5a7268; border-radius: 0; color: var(--ink); margin-bottom: 11px; padding: 16px 18px 14px; -unity-text-align: middle-left; }
.thread-card:hover { background-color: #1a2925; border-color: #65715c; }
.thread-card-pinned { border-left-width: 3px; border-left-color: #c3a46a; }
.thread-card-header, .thread-card-footer, .tag-row, .post-meta, .user-row { flex-direction: row; align-items: center; }
.thread-card-header { margin-bottom: 7px; }
.official-badge, .pinned-badge, .board-badge, .tag { font-size: 12px; padding: 3px 7px; margin-right: 6px; border-width: 1px; border-radius: 0; }
.official-badge { color: #e6e6bc; background-color: #4d5638; border-color: #7d8253; }
.pinned-badge { color: #efd2a4; background-color: #4f3b2c; border-color: #8a684c; }
.board-badge { color: #c8e0ce; background-color: #234036; border-color: #638775; }
.thread-title { color: #e8e5d9; font-size: 17px; -unity-font-style: bold; margin-bottom: 6px; white-space: normal; }
.thread-excerpt { color: #d0dacf; font-size: 16px; white-space: normal; margin-bottom: 12px; }
.thread-card-footer { color: #b5c5b9; font-size: 13px; }
.thread-time { margin-left: 12px; }
.thread-replies { margin-left: auto; color: #aeb47c; }
.tag-row { margin-top: 10px; }
.tag { color: #d1dfd2; border-color: #5e7668; background-color: #284037; }
.sidebar-card { background-color: #263933; border-width: 1px; border-color: #597067; padding: 15px; margin-bottom: 14px; }
.announcement-card { border-top-width: 2px; border-top-color: #8d8c5b; }
.sidebar-copy { color: #d4ded2; font-size: 14px; white-space: normal; margin-bottom: 5px; }
.build-stamp { color: #bdc7a5; font-size: 12px; letter-spacing: 1px; margin-top: 14px; }
.user-row { height: 25px; }
.presence-dot { width: 6px; height: 6px; background-color: #a4b56e; border-radius: 8px; margin-right: 7px; }
.user-name { color: #e0e6d9; font-size: 13px; }
.user-presence { color: #bccfc0; font-size: 12px; margin-left: auto; }
.hot-thread-link { background-color: transparent; border-width: 0; border-bottom-width: 1px; border-bottom-color: #263832; border-radius: 0; color: #aeb8ab; font-size: 12px; padding: 8px 0; -unity-text-align: middle-left; white-space: normal; }
.hot-thread-link:hover { color: #e4e4c1; background-color: transparent; }
.event-card { border-color: #554936; }
.event-button { margin-left: 0; margin-top: 11px; }
.detail-view { flex-grow: 1; }
.back-button { align-self: flex-start; background-color: transparent; border-width: 0; border-radius: 0; color: #bbc184; padding-left: 0; margin-bottom: 16px; }
.back-button:hover { color: #f0efb5; background-color: transparent; }
.detail-kicker { color: #8fa38f; font-size: 11px; letter-spacing: 1px; margin-bottom: 7px; }
.detail-title { color: #e7e6da; font-size: 26px; -unity-font-style: bold; white-space: normal; margin-bottom: 14px; }
.post-block { background-color: #2b3e38; border-width: 1px; border-color: #597267; border-left-width: 3px; border-left-color: #bfd192; padding: 16px 18px; margin-bottom: 12px; }
.post-meta { margin-bottom: 10px; }
.post-author { color: #f0f2cb; font-size: 15px; -unity-font-style: bold; }
.post-time { color: #bcccbf; font-size: 13px; margin-left: 9px; }
.post-floor { color: #b8cbb8; font-size: 13px; margin-left: auto; }
.post-body { color: #f1f3ed; font-size: 17px; white-space: normal; }
.reply-heading { color: #b3b98b; font-size: 13px; -unity-font-style: bold; margin-top: 9px; margin-bottom: 8px; }
.reply-locked { flex-direction: row; align-items: center; justify-content: space-between; border-top-width: 1px; border-top-color: #2f403a; padding-top: 14px; margin-top: 8px; }
.reply-locked-text { color: #778078; font-size: 12px; }
.footer { height: 26px; border-top-width: 1px; border-top-color: #273531; justify-content: center; padding-top: 8px; }
.footer-label { color: #b6c6b8; font-size: 12px; letter-spacing: 0.5px; }

.case-action { flex-direction: row; align-items: center; justify-content: space-between; background-color: #15211e; border-width: 1px; border-color: #566045; padding: 12px 14px; margin-top: 12px; }
.case-status { color: #d3d49a; font-size: 12px; }
.case-enter-button { background-color: #566045; border-width: 1px; border-color: #8b956c; border-radius: 0; color: #f0efd3; font-size: 12px; }
.case-enter-button:disabled { opacity: 1; background-color: #202b29; border-color: #39443f; color: #7b857d; }

.player-status { color: #aeb694; font-size: 11px; margin-right: 9px; }
.main-menu-button { background-color: #30463e; border-width: 1px; border-color: #718779; border-radius: 0; color: #edf0e5; font-size: 14px; margin-right: 4px; }
.main-menu-button:hover { color: #e4e5c4; background-color: #182622; }

.compose-view { flex-grow: 1; background-color: #263833; border-width: 1px; border-color: #5a7167; padding: 22px; }
.forum-field { margin-top: 12px; }
.forum-body-field { margin-top: 12px; min-height: 150px; }
.reply-composer { background-color: #2b3d37; border-width: 1px; border-color: #62796e; margin-top: 16px; padding: 16px; }
.reply-input { min-height: 74px; margin-bottom: 8px; }
.form-actions { flex-direction: row; align-items: center; margin-top: 8px; }
.form-message { color: #f0bd9e; font-size: 14px; flex-grow: 1; white-space: normal; }
.forum-notice { color: #d5c881; background-color: #23271c; border-left-width: 2px; border-left-color: #9e9454; padding: 9px 11px; margin-bottom: 10px; white-space: normal; }
.profile-name { color: #d9dfbb; font-size: 16px; -unity-font-style: bold; margin-bottom: 8px; }
.profile-card { border-color: #52624b; }

.mode-button { background-color: #273b34; border-width: 1px; border-color: #587064; border-radius: 0; color: #dce5d8; font-size: 14px; margin-left: 10px; padding: 9px 13px; }
.mode-button:hover { background-color: #3b5547; color: #ffffff; }
.mode-selected { background-color: #556747; border-color: #d0d89a; color: #ffffff; }
.compact-topbar .subtitle { display: none; }
.compact-topbar .wordmark { font-size: 18px; letter-spacing: 1.5px; }
.compact-topbar .mode-button { margin-left: 6px; padding: 8px 9px; font-size: 13px; }
.compact-offline .right-rail { display: none; }
.narrow-forum .left-rail { width: 170px; }
.narrow-forum .community-heading { flex-direction: row; align-items: center; flex-wrap: wrap; }
.narrow-forum .community-heading-actions { flex-wrap: wrap; }
.narrow-forum .community-heading .page-description { display: none; }
.narrow-forum .community-content-row { flex-direction: column; }
.narrow-forum .community-board-column { width: 100%; margin-right: 0; margin-bottom: 8px; padding: 8px; }
.narrow-forum .community-board-column .section-label { margin-bottom: 4px; }
.narrow-forum #community-board-list { flex-direction: row; flex-wrap: nowrap; }
.narrow-forum #community-board-list .board-link { margin-right: 6px; margin-bottom: 0; white-space: nowrap; }
.narrow-forum .community-topic-column { width: 100%; min-width: 0; }
.compact-profile-status { display: none; color: #d8e3d0; font-size: 13px; white-space: normal; margin-top: 12px; }
.compact-offline .compact-profile-status { display: flex; }
.compact-resume-button { display: none; margin-top: 10px; }
.compact-offline .compact-resume-visible { display: flex; }
.community-view { display: none; flex-grow: 1; }
.community-heading { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.community-heading-actions, .community-auth-actions, .community-list-heading, .community-account-heading { flex-direction: row; align-items: center; }
.community-heading-actions .account-name { font-size: 14px; margin-right: 8px; }
.community-heading-actions .main-menu-button { font-size: 13px; }
.community-status { background-color: #34483d; border-left-width: 3px; border-left-color: #c9d594; color: #f0f3e8; font-size: 15px; padding: 7px 10px; margin-bottom: 9px; white-space: normal; }
.community-error { background-color: #503b35; border-left-color: #efb092; color: #ffe2d3; }
.community-account-card { display: none; background-color: #2a3d36; border-width: 1px; border-color: #688173; padding: 11px 16px; margin-bottom: 10px; }
.community-account-heading { justify-content: space-between; }
.community-account-heading .sidebar-title { margin-bottom: 0; }
.community-account-heading .account-name { margin-left: auto; margin-right: 14px; }
.account-name { color: #e8efc5; font-size: 16px; -unity-font-style: bold; }
.community-auth-form { display: none; flex-direction: column; margin-top: 12px; margin-bottom: 12px; }
.community-auth-field { margin-top: 9px; max-width: 720px; }
.community-auth-actions { margin-top: 12px; }
.community-consent { color: #e0e9dc; font-size: 14px; margin-top: 12px; white-space: normal; }
.community-content-row { flex-direction: row; align-items: flex-start; }
.community-board-column { width: 220px; background-color: #273a34; border-width: 1px; border-color: #597267; padding: 16px; margin-right: 16px; }
#community-board-strip { flex-grow: 0; }
.community-topic-column { flex-grow: 1; min-width: 0; }
.community-list-heading { justify-content: space-between; margin-bottom: 12px; }
.community-list-heading .detail-title { margin-bottom: 0; }
.empty-state { color: #d0dccc; font-size: 16px; padding: 22px; background-color: #2b3d37; border-width: 1px; border-color: #597267; }
.forum-shell .unity-base-field__label { color: #e4ebde; font-size: 15px; min-width: 148px; }
.forum-shell .unity-text-field__input { background-color: #324940; color: #f6f7f0; border-width: 1px; border-color: #829a89; border-radius: 0; font-size: 16px; padding: 9px 11px; }
.forum-shell .unity-base-popup-field__input { background-color: #324940; color: #f6f7f0; border-width: 1px; border-color: #829a89; border-radius: 0; font-size: 16px; }
.forum-shell .unity-text-field__input:focus { background-color: #3b5548; border-color: #d0de9c; }
.forum-shell .unity-toggle__label { color: #e0e9dc; font-size: 14px; white-space: normal; }
.forum-shell .unity-toggle__input { background-color: #324940; }
.forum-shell .unity-scroller { background-color: #23342e; }
.forum-shell .unity-scroller .unity-repeat-button { background-color: #30443e; -unity-background-image-tint-color: #d3dfcf; }
.forum-shell .unity-scroller .unity-base-slider__tracker { background-color: #31463e; }
.forum-shell .unity-scroller .unity-base-slider__dragger { background-color: #718b78; border-width: 1px; border-color: #9bae9b; }
.forum-shell .unity-scroll-view__vertical-scroller { width: 14px; }
.forum-shell .unity-scroll-view__horizontal-scroller { height: 14px; }
