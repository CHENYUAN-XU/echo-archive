.menu-shell { flex-grow: 1; justify-content: center; align-items: center; background-color: #08100f; color: #d7d9ce; }
.menu-grain { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(111, 133, 103, 0.035); }
.menu-frame { width: 490px; background-color: #101a18; border-width: 1px; border-color: #405149; border-top-width: 3px; border-top-color: #98965b; padding: 34px 38px 28px; }
.menu-wordmark { color: #e4e6a9; font-size: 31px; -unity-font-style: bold; letter-spacing: 4px; }
.menu-subtitle { color: #89958d; font-size: 13px; margin-top: 8px; letter-spacing: 1px; }
.menu-rule { height: 1px; background-color: #394940; margin-top: 24px; margin-bottom: 20px; }
.profile-label { color: #d1d6ba; font-size: 14px; }
.menu-notice { color: #9aa397; font-size: 12px; white-space: normal; margin-top: 8px; min-height: 30px; }
.menu-actions { margin-top: 20px; }
.menu-button { background-color: #162522; border-width: 1px; border-color: #45554c; border-radius: 0; color: #d6dbce; height: 38px; margin-bottom: 9px; -unity-text-align: middle-left; padding-left: 14px; }
.menu-button:hover { background-color: #253831; color: #f2f0d0; border-color: #8e966c; }
.menu-button:disabled { opacity: 1; color: #68736c; background-color: #111b19; border-color: #293833; }
.primary-menu-button { background-color: #4e5639; border-color: #848b62; color: #f0edca; }
.quiet-menu-button { color: #8c9790; }
.profile-create { margin-top: 12px; border-top-width: 1px; border-top-color: #3c4a43; padding-top: 18px; }
.create-title { color: #c9cb94; font-size: 14px; -unity-font-style: bold; margin-bottom: 12px; }
.profile-input { color: #d6dbce; margin-bottom: 14px; }
.profile-input .unity-text-field__input { background-color: #0c1513; border-color: #43534b; color: #e3e5d7; }
.create-actions { flex-direction: row; }
.create-actions .menu-button { flex-grow: 1; margin-right: 8px; }
.menu-footer { color: #617067; font-size: 10px; letter-spacing: 1px; margin-top: 22px; }
